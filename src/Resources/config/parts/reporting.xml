<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Twint\Reporting\DataAbstractionLayer\TransactionReport\TransactionReportDefinition">
            <tag name="shopware.entity.definition" entity="twint_transaction_report"/>
        </service>

        <service id="Twint\Reporting\ScheduledTask\TurnoverReportingTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Twint\Reporting\ScheduledTask\TurnoverReportingTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Twint\Reporting\Service\TransactionReportService"/>
            <argument>%kernel.shopware_version%</argument>
            <argument>%instance_id%</argument>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="Twint\Reporting\Subscriber\OrderTransactionSubscriber">
            <argument type="service" id="twint_transaction_report.repository"/>
            <argument type="service" id="Twint\Core\Service\SettingServiceInterface"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Twint\Reporting\Service\TransactionReportService">
            <argument type="service" id="twint_transaction_report.repository"/>
            <argument type="service" id="Twint\Core\Service\SettingServiceInterface"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Twint\Reporting\Subscriber\OrderTransactionSubscriber">
            <argument type="service" id="Twint\Reporting\Service\TransactionReportService"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>