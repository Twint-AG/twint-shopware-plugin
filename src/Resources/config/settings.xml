<?xml version="1.0" encoding="UTF-8"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>Environment</title>
        <title lang="de-DE">Umgebung</title>
        <title lang="de-CH">Umgebung</title>
        <title lang="fr-FR">Environnement</title>
        <title lang="fr-CH">Environnement</title>
        <title lang="it-IT">Ambiente</title>
        <title lang="it-CH">Ambiente</title>

        <component name="twint-mode">
            <name>testMode</name>
            <defaultValue>false</defaultValue>
        </component>
    </card>

    <card>
        <title>Credentials</title>
        <title lang="de-DE">Zugangsdaten</title>
        <title lang="de-CH">Zugangsdaten</title>
        <title lang="fr-FR">Identifiants</title>
        <title lang="fr-CH">Identifiants</title>
        <title lang="it-IT">Credenziali</title>
        <title lang="it-CH">Credenziali</title>

        <input-field>
            <name>storeUuid</name>
            <label>Store UUID</label>
            <label lang="de-DE">UUID Ihres Stores</label>
            <label lang="de-CH">UUID Ihres Stores</label>
            <label lang="fr-FR">UUID de votre commerce</label>
            <label lang="fr-CH">UUID de votre commerce</label>
            <label lang="it-IT">UUID del suo negozio</label>
            <label lang="it-CH">UUID del suo negozio</label>
            <required>true</required>
            <placeholder>xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx</placeholder>
            <helpText>The Store UUID is provided by TWINT</helpText>
            <helpText lang="de-DE">Die UUID Ihres Stores wird von TWINT bereitgestellt</helpText>
            <helpText lang="de-CH">Die UUID Ihres Stores wird von TWINT bereitgestellt</helpText>
            <helpText lang="fr-FR">L’UUID de votre commerce est fourni par TWINT</helpText>
            <helpText lang="fr-CH">L’UUID de votre commerce est fourni par TWINT</helpText>
            <helpText lang="it-IT">L’UUID del suo negozio è fornito da TWINT.</helpText>
            <helpText lang="it-CH">L’UUID del suo negozio è fornito da TWINT.</helpText>
        </input-field>

        <component name="twint-certificate">
            <name>certificate</name>
            <label>Certificate file</label>
            <label lang="de-DE">Zertifikatsdatei</label>
            <label lang="de-CH">Zertifikatsdatei</label>
            <label lang="fr-FR">Fichier de certificat</label>
            <label lang="fr-CH">Fichier de certificat</label>
            <label lang="it-IT">File del certificato</label>
            <label lang="it-CH">File del certificato</label>
            <required>true</required>
        </component>
    </card>
</config>
