{% sw_extends "@Storefront/storefront/component/product/card/action.html.twig" %}

{# Set in outer scope before blocks #}
{% do resetPlpRendered() %}

{# this one for 6.7 #}
{% block component_product_box_action_buy_button %}
    {{ parent() }}
    
    {% if not isPlpRendered() and isTwintExpress('PLP') %}
        {% sw_include '@Storefront/storefront/component/button/express-checkout-button.html.twig' %}
    {% endif %}

    {% do markPlpRendered() %}
{% endblock %}

{# for older version of shopware #}
{% block page_product_detail_product_buy_button %}
    {{ parent() }}

    {% if not isPlpRendered() and isTwintExpress('PLP') %}
        {% sw_include '@Storefront/storefront/component/button/express-checkout-button.html.twig' %}
    {% endif %}  

    {% do markPlpRendered() %}  
{% endblock %}
