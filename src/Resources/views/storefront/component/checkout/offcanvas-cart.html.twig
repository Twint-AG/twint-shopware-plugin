{% sw_extends "@Storefront/storefront/component/checkout/offcanvas-cart.html.twig" %}

{% block component_offcanvas_cart_actions_checkout %}
    {{ parent() }}

    {% block twint_buy_button_plp %}
        {% if isTwintExpress('CART_FLYOUT') %}
            {% sw_include '@Storefront/storefront/component/button/express-checkout-button.html.twig' with {
                'useCart': true,
                'disabled': not isCartNotEmpty,
            } %}
        {% endif %}
    {% endblock %}
{% endblock %}
