<div class="sw-order-detail-twint">
    {% block sw_order_detail_twint_actions_row_reversal_form %}
        <component :is="cardComponent"
               v-if="canRefund"
               position-identifier="twint-details-actions"
               :title="$tc('twint.order.refundAction.cardTitle')">
            {% block sw_order_detail_twint_actions_rows %}
                <template #default>
                    <sw-container type="row">
                        {% block sw_order_detail_twint_actions_row_primary %}
                            <div class="twint-payment-actions__button-container">
                                <span class="twint-refundable-amount__title" v-if="refundableAmount > 0">
                                    {{ $tc('twint.order.refund.refundable.title') }}
                                </span>
                                <span class="twint-refundable-amount__notice" v-if="refundableAmount === 0">
                                {{ $tc('twint.order.refund.refundable.fullRefundNotice') }}
                                </span>
                                <sw-label v-if="refundableAmount > 0">{{ currencyFilter(refundableAmount, currency, decimalPrecision) }}</sw-label>
                                <sw-button variant="primary"
                                           size="small"
                                           :disabled="refundableAmount === 0 || !acl.can('order.editor')"
                                           @click="showModal">
                                    {{ $tc('twint.order.refund.buttons.refund.label') }}
                                </sw-button>
                            </div>
                            {% block twint_modal_refund %}
                                <sw-modal variant="small"
                                          :title="$tc(`twint.order.refund.modal.title`)" v-if="showRefundModal" @modal-close="onCloseModal">
                                    {% block twint_refund_amount %}
                                            <mt-number-field v-if="isShopwareGte67"
                                                    v-model:value="refundAmount"
                                                    number-type="float"
                                                    ref="refundAmountField"
                                                    :step="dynamicStep"
                                                    :digits="22"
                                                    :label="$tc('twint.order.refundAction.refundAmount.label')"
                                                    :help-text="$tc('twint.order.refundAction.refundAmount.helpText')"
                                                    :error="amountError"
                                                    @update:model-value="amountInputChanged"
                                                    required
                                            >
                                                <template #suffix>
                                                    {{ currency }}
                                                </template>
                                            </mt-number-field>
                                            <sw-number-field
                                                    v-else
                                                    v-model="refundAmount"
                                                    numberType="float"
                                                    ref="refundAmountField"
                                                    :step="dynamicStep"
                                                    :digits="22"
                                                    :label="$tc('twint.order.refundAction.refundAmount.label')"
                                                    :helpText="$tc('twint.order.refundAction.refundAmount.helpText')"
                                                    :error="amountError"
                                                    @update:value="amountInputChanged"
                                                    required
                                            >
                                                <template #suffix>
                                                    {{ currency }}
                                                </template>
                                            </sw-number-field>
                                    {% endblock %}

                                    {% block twint_refund_reason %}
                                        <twint-textarea-input
                                                v-model:value="reason"
                                                maxLength="2048"
                                                :label="$tc('twint.order.refundAction.reason.label')"
                                                :placeholder="$tc('twint.order.refundAction.reason.placeholder')">
                                        </twint-textarea-input>
                                    {% endblock %}

                                    {% block twint_refund_confirm_button %}
                                        <template #modal-footer>
                                                <mt-button v-if="isShopwareGte67"
                                                        variant="primary" :disabled="amountError || refundAmount<=0"
                                                        @click="refund"
                                                >
                                                    {{ $tc('twint.order.refundAction.confirmButton.text') }}
                                                </mt-button>
                                                <sw-button v-else variant="primary" :disabled="amountError || refundAmount<=0"
                                                           @click="refund">
                                                    {{ $tc('twint.order.refundAction.confirmButton.text') }}
                                                </sw-button>

                                        </template>
                                    {% endblock %}

                                    <sw-loader v-if="isLoading"></sw-loader>
                                </sw-modal>
                            {% endblock %}
                        {% endblock %}
                    </sw-container>
                </template>
            {% endblock %}
        </component>
    {% endblock %}
    {% block sw_order_detail_twint_actions_row_reversal_history %}
        <component :is="cardComponent"
                   position-identifier="twint-details-actions-reversal-list"
                   :title="$tc('twint.order.reversalHistory.cardTitle')">
            <template #grid>
                <sw-container type="row">
                {% block sw_order_detail_twint_reversal_history_grid %}
                    <sw-data-grid v-if="reversalHistory.length > 0" :data-source="reversalHistory"
                                  :columns="paymentColumns"
                                  {% if not VUE2 %}
                                      :show-actions="false"
                                      :show-selection="false">
                                  {% else %}
                                      :showActions="false"
                                      :showSelection="false">
                                  {% endif %}
                                  :show-actions="false"
                                  :show-selection="false">
                        <template #column-createdAt="{ item }">
                            {{ dateFilter(item.createdAt) }}
                        </template>
                        <template #column-amount="{ item }">
                            {{ currencyFilter(item.amount, item.currency, decimalPrecision)}}
                        </template>
                    </sw-data-grid>
                </sw-container>
                {% endblock %}
            </template>
        </component>
    {% endblock %}
</div>
