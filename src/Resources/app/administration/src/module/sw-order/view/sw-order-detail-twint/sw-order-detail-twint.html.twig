{% block sw_order_detail_twint %}
    <div class="sw-order-twint-detail">
        {% block sw_order_detail_twint_reversal_card %}
            <twint-payment-actions
                    v-if="order"
                    :order="order"
                    :orderId="orderId"
                    :currency="order.currency.isoCode"
                    :decimalPrecision="order.itemRounding.decimals"
                    :totalAmount="order.amountTotal"
            >
            </twint-payment-actions>
            <sw-loader v-if="isLoading && !order"></sw-loader>
        {% endblock %}
        <component :is="cardComponent" :title="$tc('twint.order.transactionLog.cardTitle')" class="twint-transaction-log">
            {% block sw_order_detail_twint_transaction_log_card_grid %}
                <template #grid>
                    <sw-container type="row">
                        {% block twint_transaction_log_list_content %}
                            <sw-entity-listing
                                    class="twint-transaction-logs-grid"
                                    v-if="transactionLogs"
                                    :items="transactionLogs"
                                    :repository="transactionLogRepository"
                                    :columns="transactionLogColumns"
                                    :sort-by="sortBy"
                                    :sort-direction="sortDirection"
                                    {% if not VUE2 %}
                                        :is-loading="isLoading"
                                        :show-selection="false"
                                        :allow-delete="false"
                                        :show-delete="false"
                                        :compact-mode="true"
                                    {% else %}
                                        :isLoading="isLoading"
                                        :showActions="false"
                                        :allowDelete="false"
                                        :showDelete="false"
                                    {% endif %}
                                    :full-page="false"
                                    @on-add-new-refund="getTransactionLogList">

                                {% block twint_transaction_log_list_content_order %}
                                    <template #column-orderId="{ item }">
                                        {% if item.order is not null and item.order.orderNumber is not null %}
                                            <router-link :to="{ name: 'sw.order.detail', params: { id: item.orderId }, query: { edit: false } }">
                                                {{ item.order.orderNumber }}
                                            </router-link>
                                        {% else %}
                                            {{ item.orderId }}
                                        {% endif %}
                                    </template>
                                {% endblock %}

                                {% block twint_transaction_log_list_content_api_method %}
                                    <template #column-apiMethod="{ item }">
                                        <sw-label>{{ item.apiMethod }}</sw-label>
                                    </template>
                                {% endblock %}

                                {% block twint_transaction_log_list_content_soap_action %}
                                    <template #column-soapAction="{ item }">
                                        <sw-label v-for="action in item.soapAction">{{ action }}</sw-label>
                                    </template>
                                {% endblock %}

                                {% block twint_transaction_log_list_content_transaction %}
                                    <template #column-transactionId="{ item }">
                                        {{ item.transactionId }}
                                    </template>
                                {% endblock %}

                                {% block twint_transaction_log_list_content_payment %}
                                    <template #column-paymentStateId="{ item }">
                                        {% if item.paymentStateMachineState is not null %}
                                            <sw-label :variant="getVariantState('order_transaction', item.paymentStateMachineState)" appearance="badged" v-if="item.paymentStateMachineState.name !== ''">
                                                {{ item.paymentStateMachineState.name }}
                                            </sw-label>
                                        {% endif %}
                                    </template>
                                {% endblock %}

                                {% block twint_transaction_log_list_content_order %}
                                    <template #column-orderStateId="{ item }">
                                        {% if item.orderStateMachineState is not null %}
                                            <sw-label :variant="getVariantState('order', item.orderStateMachineState)" appearance="badged" v-if="item.paymentStateMachineState.name !== ''">
                                                {{ item.orderStateMachineState.name }}
                                            </sw-label>
                                        {% endif %}
                                    </template>
                                {% endblock %}

                                {% block twint_transaction_log_list_content_created_at %}
                                    <template #column-createdAt="{ item }">
                                        {{ dateFilter(item.createdAt) }}
                                    </template>
                                {% endblock %}

                                {% block twint_transaction_log_list_content_actions %}
                                    <template #actions="{ item }">
                                        {% block twint_transaction_log_list_content_actions_view %}
                                            <sw-context-menu-item class="twint-transaction-log-grid-btn-view"
                                                                  @click="onOpenModalDetail(item.id)">
                                                {{ $tc('twint.order.transactionLog.list.columns.action.view') }}
                                            </sw-context-menu-item>
                                        {% endblock %}
                                    </template>
                                {% endblock %}
                                {% block twint_transaction_log_list_content_action_modals %}
                                    <template #action-modals="{ item }">
                                        {% block twint_transaction_log_list_content_action_detail_modal %}
                                            <sw-modal
                                                    v-if="showTransactionLogDetailModal === item.id"
                                                    :title="$tc('twint.order.transactionLog.list.modal.title')"
                                                    variant="large"
                                                    @modal-close="onCloseModalDetail"
                                            >
                                                <div class="sw-data-grid">
                                                    <table class="sw-data-grid__table">
                                                        <tbody class="sw-data-grid__body">
                                                            <tr class="sw-data-grid__row" v-if="item.order.orderNumber !== ''">
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content">
                                                                        <b>{{ $tc('twint.order.transactionLog.list.columns.orderID') }}:</b>
                                                                    </div>
                                                                </td>
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content">
                                                                        {% if item.order is not null and item.order.orderNumber is not null %}
                                                                            {{ item.order.orderNumber }}
                                                                        {% else %}
                                                                            {{ item.orderId }}
                                                                        {% endif %}
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <tr class="sw-data-grid__row" v-if="item.apiMethod !== null">
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content">
                                                                        <b>{{ $tc('twint.order.transactionLog.list.columns.apiMethod') }}:</b>
                                                                    </div>
                                                                </td>
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content"> {{ item.apiMethod }}</div>
                                                                </td>
                                                            </tr>
                                                            <tr class="sw-data-grid__row" v-if="item.transactionId !== null">
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content">
                                                                        <b>{{ $tc('twint.order.transactionLog.list.columns.transaction') }}:</b>
                                                                    </div>
                                                                </td>
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content"> {{ item.transactionId }}</div>
                                                                </td>
                                                            </tr>
                                                            <tr class="sw-data-grid__row" v-if="item.paymentStateMachineState.name !== ''">
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content">
                                                                        <b>{{ $tc('twint.order.transactionLog.list.columns.payment') }}:</b>
                                                                    </div>
                                                                </td>
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content">
                                                                        {% if item.paymentStateMachineState is not null %}
                                                                            <sw-label :variant="getVariantState('order_transaction', item.paymentStateMachineState)" appearance="badged" v-if="item.paymentStateMachineState.name !== ''">
                                                                                {{ item.paymentStateMachineState.name }}
                                                                            </sw-label>
                                                                        {% else %}
                                                                            {{ item.paymentStateId }}
                                                                        {% endif %}
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <tr class="sw-data-grid__row" v-if="item.orderStateMachineState.name !== ''">
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content">
                                                                        <b>{{ $tc('twint.order.transactionLog.list.columns.order') }}:</b>
                                                                    </div>
                                                                </td>
                                                                <td class="sw-data-grid__cell">
                                                                    <div class="sw-data-grid__cell-content">
                                                                        {% if item.orderStateMachineState is not null %}
                                                                            <sw-label :variant="getVariantState('order', item.orderStateMachineState)" appearance="badged"  v-if="item.orderStateMachineState.name !== ''">
                                                                                {{ item.orderStateMachineState.name }}
                                                                            </sw-label>
                                                                        {% else %}
                                                                            {{ item.orderStateId }}
                                                                        {% endif %}
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                {% block twint_transaction_log_list_content_action_detail_modal_order %}
                                                    <sw-card>
                                                        <b class="sw-order-detail-twint-modal-soap-request">
                                                            {{ $tc('twint.order.transactionLog.list.columns.request') }}
                                                        </b>
                                                        <sw-textarea-field :disabled="true" :value="item.request" />
                                                        <b class="sw-order-detail-twint-modal-soap-response">
                                                            {{ $tc('twint.order.transactionLog.list.columns.response') }}
                                                        </b>
                                                        <sw-textarea-field :disabled="true" :value="item.response"/>
                                                        <div v-if="item.exception != ' '">
                                                            <p class="sw-order-detail-twint-modal-exception">
                                                                <b>{{ $tc('twint.order.transactionLog.list.columns.exception') }}</b>
                                                            </p>
                                                            <sw-textarea-field :disabled="true" :value="item.exception"/>
                                                        </div>
                                                    </sw-card>
                                                    <sw-card v-for="(request, index) in item.soapRequest">
                                                        <sw-container>
                                                            <h4>{{ item.soapAction[index] }}</h4>
                                                            <b class="sw-order-detail-twint-modal-soap-request">
                                                                {{ $tc('twint.order.transactionLog.list.columns.soapRequest') }}
                                                            </b>
                                                            <sw-textarea-field :disabled="true" :value="request"/>

                                                            <b class="sw-order-detail-twint-modal-soap-response" v-if="item.soapResponse[index]">
                                                                {{ $tc('twint.order.transactionLog.list.columns.soapResponse') }}
                                                            </b>
                                                            <sw-textarea-field  v-if="item.soapResponse[index]" :disabled="true" :value="item.soapResponse[index]"/>
                                                        </sw-container>
                                                    </sw-card>
                                                {% endblock %}

                                                {% block twint_transaction_log_list_content_action_detail_modal_footer %}
                                                    <template #modal-footer>
                                                        {% block twint_transaction_log_list_content_action_detail_modal_close %}
                                                            <sw-button size="small" @click="onCloseModalDetail">
                                                                {{ $tc('twint.order.transactionLog.list.modal.close') }}
                                                            </sw-button>
                                                        {% endblock %}
                                                    </template>
                                                {% endblock %}
                                            </sw-modal>
                                        {% endblock %}
                                    </template>
                                {% endblock %}
                            </sw-entity-listing>
                        {% endblock %}
                    </sw-container>
                </template>
            {% endblock %}
        </component>
    </div>
{% endblock %}
