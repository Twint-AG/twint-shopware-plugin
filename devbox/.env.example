# ── Devbox configuration ─────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in. Compose auto-reads .env; the
# bin/ scripts source it too (via _lib.sh).

# Base domain. Instances are served at swXX-$DOMAIN_BASE (hyphen-joined), i.e.
#   sw65-$DOMAIN_BASE, sw66-$DOMAIN_BASE, sw67-$DOMAIN_BASE
#   Local testing: keep 'twint-dev' -> sw65-twint-dev etc.; add /etc/hosts entries.
#   Real domain (Route53): e.g. twint.dev.nfq-asia.com -> sw65-twint.dev.nfq-asia.com
#     (wildcard record *.dev.nfq-asia.com -> EC2 IP)
DOMAIN_BASE=twint-dev

# GitLab plugin repo. Accepts any form — deploy.sh normalizes to host/path:
#   git@git.nfq.asia:twint-ag/twint-shopware-plugin.git  (SSH)
#   git.nfq.asia/twint-ag/twint-shopware-plugin.git       (host+path)
GIT_REMOTE=git@git.nfq.asia:twint-ag/twint-shopware-plugin.git

# Private VCS dependency of the plugin (twint-ag/sdk). Same forms accepted.
#   deploy.sh registers it as a second Composer VCS repo so `composer require`
#   of the plugin resolves twint-ag/sdk.
SDK_REMOTE=git.nfq.asia/twint-ag/sdk.git

# GitLab username that owns GITLAB_TOKEN (used for http-basic auth: username + token).
GITLAB_USERNAME=your-gitlab-username

# HTTP basic auth protecting ALL instances at the Traefik proxy. up.sh hashes
# the password into devbox/auth/htpasswd (gitignored). Both are required.
BASIC_AUTH_USER=devbox
BASIC_AUTH_PASSWORD=change-me-please

# Email registered with Let's Encrypt (TLS-ALPN-01) for cert expiry notices.
# Requires public DNS for swXX-$DOMAIN_BASE + inbound :443 open on the box.
ACME_EMAIL=ops@example.com

# GitLab read token (deploy token or PAT with read_repository scope).
#   deploy.sh feeds this to `composer config --auth http-basic.<host>` (paired
#   with GITLAB_USERNAME) inside each container, for both the plugin host and
#   the SDK_REMOTE host. Keep secret. .env is gitignored; never commit a real value.
GITLAB_TOKEN=changeme

# dockware image tags per Shopware version (pinned).
SW65_IMAGE=dockware/dev:6.5.8.17
SW66_IMAGE=dockware/dev:6.6.7.0
SW67_IMAGE=dockware/dev:6.7.2.2
